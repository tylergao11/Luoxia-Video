{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luoxia.local/contracts/beats.schema.json",
  "title": "Luoxia Beats Contract",
  "description": "小说改编短剧的上游契约：把原文切成候选段落，逐段打分，落定 keep/compress/drop 决策。它回答的是「砍什么、留什么、压到多短」，产物是 timeline.json 的输入。与 timeline 的分工：beats 决定内容取舍，timeline 决定时长与排布。",
  "type": "object",
  "required": ["schema_version", "work_id", "phase", "source", "global", "cast", "beats"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "契约版本。破坏性变更必须升主版本，并在 docs/luoxia/04-BEATS-CONTRACT.md 记录迁移方式。"
    },
    "work_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "作品标识。会参与文件路径拼接，因此限制字符集。"
    },
    "title": { "type": "string" },
    "phase": {
      "type": "string",
      "enum": ["draft", "scored", "selected", "delivered"],
      "description": "draft=已切片未评分；scored=每段有类型和强度；selected=取舍决策落定并通过一致性校验；delivered=已生成 timeline 草稿。selected 之后改动决策必须重算 beats_hash。"
    },
    "selected_at": { "type": ["string", "null"], "format": "date-time" },
    "beats_hash": {
      "type": ["string", "null"],
      "description": "对 beats[].{decision, lines, source_span} 的 sha256。下游发现哈希对不上，说明取舍在交付后被偷改。"
    },
    "source": {
      "type": "object",
      "required": ["source_id", "char_count"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] },
        "uri": { "type": ["string", "null"], "description": "原文文件路径或章节地址。" },
        "char_count": {
          "type": "integer",
          "minimum": 1,
          "description": "原文总字数。所有 source_span 的偏移都相对它，压缩比也以它为分母。"
        },
        "sha256": {
          "type": ["string", "null"],
          "description": "原文内容哈希。原文一变，所有 span 偏移失效，必须重新切片。"
        }
      }
    },
    "global": {
      "type": "object",
      "required": ["keep_threshold", "compress_threshold", "max_compression_ratio", "min_drop_rate", "episode_min_peak"],
      "additionalProperties": false,
      "properties": {
        "keep_threshold": {
          "type": "number", "minimum": 0, "maximum": 10, "default": 6.5,
          "description": "强度达到该值的段落原样保留。阈值放在数据里而不是代码里，方便按题材调参。"
        },
        "compress_threshold": {
          "type": "number", "minimum": 0, "maximum": 10, "default": 3.0,
          "description": "强度低于该值直接丢弃；介于两个阈值之间的压缩成一两句话。"
        },
        "max_compression_ratio": {
          "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.15,
          "description": "台词总字数 / 原文总字数 的上限。几千字原文压到几百字对白，典型值 0.05-0.15。超过说明没真砍。"
        },
        "min_drop_rate": {
          "type": "number", "minimum": 0, "maximum": 1, "default": 0.3,
          "description": "被丢弃段落占比的下限。防止模型偷懒把所有段落都标成保留。"
        },
        "episode_min_peak": {
          "type": "number", "minimum": 0, "maximum": 10, "default": 7.0,
          "description": "每集至少要有一个段落达到该强度。没有峰值的一集必然平。"
        },
        "opening_conflict_types": {
          "type": "array",
          "items": { "$ref": "#/$defs/beat_type" },
          "default": ["conflict_escalation", "face_slap", "reversal", "identity_reveal", "emotional_peak"],
          "description": "允许出现在第一集开篇的段落类型。短剧开场十秒内必须见冲突，不允许用铺垫开场。"
        },
        "target_episode_duration_s": {
          "type": "number", "minimum": 15, "maximum": 600, "default": 90,
          "description": "单集目标时长，供 timeline 桥接时做长度预警。真实时长仍以 TTS 实测为准。"
        }
      }
    },
    "cast": {
      "type": "array",
      "description": "角色表。字段与 timeline.cast 对齐，桥接时直接透传，避免两边角色 ID 漂移。",
      "items": {
        "type": "object",
        "required": ["character_id", "display_name"],
        "additionalProperties": false,
        "properties": {
          "character_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "display_name": { "type": "string" },
          "voice_id": { "type": ["string", "null"] },
          "role": {
            "type": ["string", "null"],
            "enum": ["protagonist", "antagonist", "support", "narrator", null]
          },
          "appearance": {
            "type": ["string", "null"],
            "description": "长期固定外形（年龄/发型/服装/气质），不含表情动作。用于生成一张定妆图，全片所有镜头以它为参考图锁脸。"
          },
          "reference_image_path": {
            "type": ["string", "null"],
            "description": "定妆图本地路径。由 characters runner 写入，桥接时透传给 timeline.cast。"
          },
          "aliases": {
            "type": "array",
            "items": { "type": "string" },
            "description": "原文里对同一角色的其它称呼。切片时用于消歧，避免同一人被拆成两个角色。"
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/beat" }
    },
    "episodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/episode" }
    },
    "selection": {
      "type": "object",
      "description": "取舍统计。由校验器重算并比对，不允许手填与实际不符的数字。",
      "additionalProperties": false,
      "properties": {
        "total_source_chars": { "type": "integer", "minimum": 0 },
        "total_script_chars": { "type": "integer", "minimum": 0 },
        "compression_ratio": { "type": "number", "minimum": 0 },
        "drop_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "kept": { "type": "integer", "minimum": 0 },
        "compressed": { "type": "integer", "minimum": 0 },
        "dropped": { "type": "integer", "minimum": 0 }
      }
    },
    "repairs": {
      "type": "array",
      "description": "自动修补账本。程序每一次替模型兜底（补台词、砍句子、改类型）都必须记在这里；不留痕的兜底等于把「模型干得差」洗成「校验通过」。",
      "items": {
        "type": "object",
        "required": ["code", "severity", "detail"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "description": "如 line_invented / line_truncated / opening_type_forced" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "description": "low=记账；medium=结构微调；high=内容被凭空生成或被砍断"
          },
          "beat_id": { "type": ["string", "null"] },
          "detail": { "type": "string" },
          "actor": { "type": "string" }
        }
      }
    },
    "quality": {
      "type": "object",
      "description": "修补账本的汇总。花钱前看这个：high 不为零说明成片里有程序编的台词。",
      "additionalProperties": false,
      "properties": {
        "repair_count": { "type": "integer", "minimum": 0 },
        "by_severity": { "type": "object", "additionalProperties": { "type": "integer" } },
        "worst_severity": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
        "invented_lines": { "type": "integer", "minimum": 0 },
        "truncated_lines": { "type": "integer", "minimum": 0 }
      }
    },
    "audit": {
      "type": "array",
      "description": "追加写的审计流水。每次改动取舍都要留痕，便于事后回答「这个爽点是谁砍的」。",
      "items": {
        "type": "object",
        "required": ["at", "actor", "action"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "actor": { "type": "string", "description": "如 agent:claude / human:tyler / selector:threshold" },
          "action": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "beat_type": {
      "type": "string",
      "enum": [
        "face_slap",
        "reversal",
        "identity_reveal",
        "power_up",
        "emotional_peak",
        "conflict_escalation",
        "hook",
        "setup",
        "filler"
      ],
      "description": "段落类型。前七类是观众要看的东西，setup 是让它们成立的必要交代，filler 是默认要砍的部分。定义见 docs/luoxia/04-BEATS-CONTRACT.md。"
    },
    "beat": {
      "type": "object",
      "required": ["beat_id", "index", "source_span", "summary"],
      "additionalProperties": false,
      "properties": {
        "beat_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "index": { "type": "integer", "minimum": 0 },
        "source_span": {
          "type": "object",
          "required": ["start_char", "end_char"],
          "additionalProperties": false,
          "properties": {
            "start_char": { "type": "integer", "minimum": 0 },
            "end_char": { "type": "integer", "minimum": 1 },
            "excerpt": {
              "type": ["string", "null"],
              "description": "原文摘录片段，仅供人工比对。真源是 start/end 偏移，不是这段文本。"
            }
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "一句话说明这段原文发生了什么。它是评分的依据，也是人工复核时唯一要读的东西。"
        },
        "beat_type": { "$ref": "#/$defs/beat_type" },
        "intensity": {
          "type": "number", "minimum": 0, "maximum": 10,
          "description": "情绪强度 0-10。判定标准见规范文档的锚点表，避免每次打分尺度漂移。"
        },
        "decision": {
          "type": "string",
          "enum": ["keep", "compress", "drop"],
          "description": "keep=完整改编；compress=只留一两句最锋利的台词；drop=完全不进成片。"
        },
        "decision_locked": {
          "type": "boolean",
          "default": false,
          "description": "人工锁定。为 true 时 selector 不再按阈值覆盖该段的 decision。人的判断优先于分数。"
        },
        "drop_reason": {
          "type": ["string", "null"],
          "enum": ["flat", "redundant", "scenery", "off_arc", "merged", "pacing", null],
          "description": "丢弃理由。做成枚举是为了能统计「这一稿到底砍在哪类内容上」。"
        },
        "merged_into": {
          "type": ["string", "null"],
          "description": "drop_reason=merged 时，本段信息被并入的目标 beat_id。信息不能凭空消失。"
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" },
          "description": "本段成立所依赖的前置段落。打脸依赖此前的羞辱，反转依赖此前的误导——依赖被砍掉，爽点就不成立。这是本契约最重要的一致性约束。"
        },
        "script_char_count": {
          "type": "integer", "minimum": 0,
          "description": "本段产出台词的总字数。由 lines 重算校验，不允许手填。"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["character_id", "text"],
            "additionalProperties": false,
            "properties": {
              "character_id": { "type": "string" },
              "text": { "type": "string", "minLength": 1, "description": "改编后的台词。写成能直接送进 TTS 的口语，不是书面叙述。" },
              "delivery": { "type": ["string", "null"], "description": "情绪与语气提示，桥接时写入 dialogue.emotion。" },
              "shot_size": {
                "type": ["string", "null"],
                "enum": ["extreme_close_up", "close_up", "medium", "full", "wide", "insert", null]
              },
              "line_type": {
                "type": "string",
                "enum": ["dialogue", "narration"],
                "default": "dialogue"
              }
            }
          }
        },
        "visual": {
          "type": ["object", "null"],
          "description": "无台词画面。存在时桥接为一个 rhythm 镜头，插在本段台词之前。",
          "additionalProperties": false,
          "properties": {
            "scene_id": { "type": ["string", "null"] },
            "shot_size": {
              "type": ["string", "null"],
              "enum": ["extreme_close_up", "close_up", "medium", "full", "wide", "insert", null]
            },
            "prompt": { "type": ["string", "null"] },
            "action_duration_s": { "type": ["number", "null"], "minimum": 1, "maximum": 15 }
          }
        },
        "scene_id": { "type": ["string", "null"], "description": "本段发生的场景，透传给 timeline 便于复用同一张底图。" },
        "cliffhanger": {
          "type": ["object", "null"],
          "required": ["tier"],
          "additionalProperties": false,
          "properties": {
            "tier": {
              "type": "string",
              "enum": ["tier_1", "tier_2", "tier_3", "daily"],
              "description": "钩子强度。tier_1 全剧级，tier_2 单元级，tier_3 集内级，daily 只是节奏调剂。分级定义见规范文档。"
            },
            "question": {
              "type": ["string", "null"],
              "description": "留给观众的那个未解问题。写不出来，说明这不是钩子。"
            }
          }
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "episode": {
      "type": "object",
      "required": ["episode_id", "episode_no", "beat_ids"],
      "additionalProperties": false,
      "properties": {
        "episode_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "episode_no": { "type": "integer", "minimum": 1 },
        "title": { "type": ["string", "null"] },
        "beat_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "本集包含的 beat，必须按 beat.index 升序。只收 keep/compress 的段落。"
        },
        "target_duration_s": { "type": ["number", "null"], "minimum": 15, "maximum": 600 }
      }
    }
  }
}
